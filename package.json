{
  "name": "fisheye",
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://steinshy.github.io/FishEye",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "http-server . -p 8080 -g -c10 --brotli --gzip",
    "format": "prettier --write --check .",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run lint:md",
    "lint:js": "eslint . --ext .js",
    "lint:css": "stylelint '**/*.css' --ignore-pattern '**/*.min.css'",
    "lint:html": "html-validate '**/*.html'",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules",
    "minify": "npm run minify:css && npm run minify:js && npm run minify:html",
    "minify:css": "for file in assets/css/*.css; do lightningcss --minify --targets '> 0.5%, last 2 versions' \"$file\" --output-file \"${file%.css}.min.css\"; done",
    "minify:js": "node scripts/minify.cjs js",
    "minify:html": "node scripts/minify.cjs html",
    "optimize:images": "node scripts/optimizeImages.cjs desktop && node scripts/optimizeImages.cjs mobile",
    "update:check": "ncu",
    "update:interactive": "ncu -i",
    "update:all": "ncu -u"
  },
  "dependencies": {
    "html-validate": "^9.7.1",
    "http-server": "^14.1.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^56.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-security": "^3.0.1",
    "glob": "^11.1.0",
    "husky": "^9.1.7",
    "lighthouse": "^12.8.2",
    "lightningcss-cli": "^1.31.1",
    "lint-staged": "^16.2.7",
    "markdownlint-cli": "^0.47.0",
    "minify": "^14.1.0",
    "npm-check-updates": "^19.3.2",
    "prettier": "^3.8.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "^7.0.1"
  }
}
